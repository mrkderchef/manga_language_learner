# Core app settings
API_HOST=0.0.0.0
API_PORT=8000

# Ollama runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Primary translation model (MangaOCR handles text recognition locally, no vision model needed)
OLLAMA_TEXT_MODEL=hf.co/sugoitoolkit/Sugoi-14B-Ultra-GGUF:Q4_K_M

# Google / Gemini
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
GOOGLE_PROJECT_ID=your-project-id
GEMINI_API_KEY=your-gemini-api-key

# Lookup / rendering
KANJIAPI_BASE_URL=https://kanjiapi.dev/v1
RABBITHOLE_GINZA_ENABLED=false
RENDER_FONT_PATH=/path/to/font.ttf
