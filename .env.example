# Google Cloud credentials for OCR + Translation
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
GOOGLE_PROJECT_ID=your-project-id

# Gemini API Key (get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Ollama remote server (GPU machine)
# Requires: ollama pull minicpm-v:8b  on the remote host
OLLAMA_BASE_URL=http://10.100.10.112:11434
OLLAMA_MODEL=llama3.2-vision
